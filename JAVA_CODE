package collage;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

// ==========================================
// MAIN ENTRY POINT
// ==========================================
public class SmartCanteenApp extends JFrame {
    private CanteenService service = new CanteenService();
    private List<OrderItem> currentCart = new ArrayList<>();
    
    // UI Components
    private DefaultTableModel menuModel, cartModel, studentOrdersModel, adminOrdersModel;
    private JLabel totalLabel;
    private JTextField studentNameField;

    public SmartCanteenApp() {
        setTitle("Smart Canteen - Unified Dashboard");
        setSize(900, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        JTabbedPane tabs = new JTabbedPane();
        tabs.setFont(new Font("Segoe UI", Font.BOLD, 14));
        tabs.setBackground(Color.decode("#172554"));
        tabs.setForeground(Color.WHITE);

        tabs.addTab("1. Order Food (Student)", createOrderPanel());
        tabs.addTab("2. Live Order Status (Student)", createStudentStatusPanel());
        tabs.addTab("3. Kitchen Dashboard (Admin)", createAdminPanel());

        // Refresh tables whenever a tab is clicked
        tabs.addChangeListener(e -> refreshAllTables());

        add(tabs);
        refreshAllTables();
    }

    // ==========================================
    // UI: TAB 1 - STUDENT ORDERING
    // ==========================================
    private JPanel createOrderPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // Top: Student Name Input
        JPanel topPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        topPanel.add(new JLabel("Enter Your Name: "));
        studentNameField = new JTextField(15);
        topPanel.add(studentNameField);
        panel.add(topPanel, BorderLayout.NORTH);

        // Center: Menu (Left) and Cart (Right)
        menuModel = new DefaultTableModel(new String[]{"ID", "Name", "Type", "Price"}, 0);
        JTable menuTable = new JTable(menuModel);
        
        cartModel = new DefaultTableModel(new String[]{"Item", "Qty", "Subtotal"}, 0);
        JTable cartTable = new JTable(cartModel);

        JSplitPane splitPane = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, 
            new JScrollPane(menuTable), new JScrollPane(cartTable));
        splitPane.setDividerLocation(450);
        panel.add(splitPane, BorderLayout.CENTER);

        // Bottom: Controls
        JPanel bottomPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        JButton addBtn = new JButton("Add Selected to Cart");
        addBtn.setBackground(Color.decode("#F59E0B"));
        
        totalLabel = new JLabel("Total (inc. 5% Tax): ₹0.00   ");
        totalLabel.setFont(new Font("Arial", Font.BOLD, 14));
        
        JButton placeOrderBtn = new JButton("Place Order");
        placeOrderBtn.setBackground(Color.decode("#0F766E"));
        placeOrderBtn.setForeground(Color.WHITE);

        addBtn.addActionListener(e -> {
            int row = menuTable.getSelectedRow();
            if (row != -1) {
                String id = (String) menuModel.getValueAt(row, 0);
                MenuItem item = service.getMenuItemById(id);
                if (item != null) {
                    currentCart.add(new OrderItem(item, 1));
                    refreshAllTables();
                }
            } else {
                JOptionPane.showMessageDialog(this, "Select an item from the menu first.");
            }
        });

        placeOrderBtn.addActionListener(e -> {
            try {
                if (currentCart.isEmpty()) throw new InvalidOrderException("Your cart is empty!");
                if (studentNameField.getText().trim().isEmpty()) throw new InvalidOrderException("Please enter your name!");
                
                Order o = service.placeOrder(studentNameField.getText().trim(), currentCart);
                currentCart.clear();
                studentNameField.setText("");
                refreshAllTables();
                JOptionPane.showMessageDialog(this, "Order Placed Successfully!\nYour Token is: " + o.getToken());
            } catch (InvalidOrderException ex) {
                JOptionPane.showMessageDialog(this, ex.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
            }
        });

        bottomPanel.add(addBtn);
        bottomPanel.add(totalLabel);
        bottomPanel.add(placeOrderBtn);
        panel.add(bottomPanel, BorderLayout.SOUTH);

        return panel;
    }

    // ==========================================
    // UI: TAB 2 - LIVE STATUS (STUDENT)
    // ==========================================
    private JPanel createStudentStatusPanel() {
        JPanel panel = new JPanel(new BorderLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        
        studentOrdersModel = new DefaultTableModel(new String[]{"Token Number", "Student Name", "Status"}, 0);
        JTable table = new JTable(studentOrdersModel);
        table.setFont(new Font("Arial", Font.BOLD, 14));
        table.setRowHeight(30);

        panel.add(new JLabel("Watch your token status here:"), BorderLayout.NORTH);
        panel.add(new JScrollPane(table), BorderLayout.CENTER);
        return panel;
    }

    // ==========================================
    // UI: TAB 3 - KITCHEN ADMIN
    // ==========================================
    private JPanel createAdminPanel() {
        JPanel panel = new JPanel(new BorderLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        adminOrdersModel = new DefaultTableModel(new String[]{"Token", "Name", "Total Bill", "Current Status"}, 0);
        JTable table = new JTable(adminOrdersModel);

        JPanel bottomPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        JButton readyBtn = new JButton("Mark Order as READY");
        readyBtn.setBackground(Color.decode("#0F766E"));
        readyBtn.setForeground(Color.WHITE);
        
        JButton completeBtn = new JButton("Mark Order as COMPLETED");
        completeBtn.setBackground(Color.decode("#172554"));
        completeBtn.setForeground(Color.WHITE);

        readyBtn.addActionListener(e -> updateOrderStatus(table, OrderStatus.READY));
        completeBtn.addActionListener(e -> updateOrderStatus(table, OrderStatus.COMPLETED));

        bottomPanel.add(readyBtn);
        bottomPanel.add(completeBtn);

        panel.add(new JLabel("Admin / Kitchen Management - Select an order to update its status:"), BorderLayout.NORTH);
        panel.add(new JScrollPane(table), BorderLayout.CENTER);
        panel.add(bottomPanel, BorderLayout.SOUTH);
        return panel;
    }

    private void updateOrderStatus(JTable table, OrderStatus newStatus) {
        int row = table.getSelectedRow();
        if (row != -1) {
            String token = (String) adminOrdersModel.getValueAt(row, 0);
            service.updateOrderStatus(token, newStatus);
            refreshAllTables();
            JOptionPane.showMessageDialog(this, "Order " + token + " updated to " + newStatus);
        } else {
            JOptionPane.showMessageDialog(this, "Please select an order from the list first.");
        }
    }

    // ==========================================
    // UI: REFRESH DATA LOGIC
    // ==========================================
    private void refreshAllTables() {
        // Refresh Menu
        menuModel.setRowCount(0);
        for (MenuItem item : service.getMenu()) {
            menuModel.addRow(new Object[]{item.getId(), item.getName(), item.getPreparationType(), "₹" + item.getPrice()});
        }

        // Refresh Cart
        cartModel.setRowCount(0);
        BigDecimal subtotal = BigDecimal.ZERO;
        for (OrderItem oi : currentCart) {
            cartModel.addRow(new Object[]{oi.getItem().getName(), oi.getQuantity(), "₹" + oi.calculateTotal()});
            subtotal = subtotal.add(oi.calculateTotal());
        }
        BigDecimal tax = subtotal.multiply(new BigDecimal("0.05"));
        totalLabel.setText("Total (inc. 5% Tax): ₹" + subtotal.add(tax) + "   ");

        // Refresh Orders (Student & Admin views)
        studentOrdersModel.setRowCount(0);
        adminOrdersModel.setRowCount(0);
        for (Order o : service.getAllOrders()) {
            studentOrdersModel.addRow(new Object[]{o.getToken(), o.getStudentName(), o.getStatus()});
            adminOrdersModel.addRow(new Object[]{o.getToken(), o.getStudentName(), "₹" + o.calculateTotal(), o.getStatus()});
        }
    }

    // Main App Launcher
    public static void main(String[] args) {
        try {
            for (UIManager.LookAndFeelInfo info : UIManager.getInstalledLookAndFeels()) {
                if ("Nimbus".equals(info.getName())) {
                    UIManager.setLookAndFeel(info.getClassName());
                    break;
                }
            }
        } catch (Exception e) {}

        SwingUtilities.invokeLater(() -> new SmartCanteenApp().setVisible(true));
    }
}

// ==========================================
// OOP CONCEPTS & LOGIC LAYER
// ==========================================

// Exception Handling
class InvalidOrderException extends Exception {
    public InvalidOrderException(String message) { super(message); }
}

// Interfaces
interface Billable {
    BigDecimal calculateTotal();
}

interface OrderManageable {
    void updateOrderStatus(String token, OrderStatus newStatus);
}

enum OrderStatus {
    PLACED, READY, COMPLETED
}

// OOP: Encapsulation & Inheritance (Abstract Base Class)
abstract class MenuItem {
    private String id;
    private String name;
    private BigDecimal price;

    public MenuItem(String id, String name, BigDecimal price) {
        this.id = id; this.name = name; this.price = price;
    }

    public String getId() { return id; }
    public String getName() { return name; }
    public BigDecimal getPrice() { return price; }

    // OOP: Polymorphism (Abstract method to be overridden)
    public abstract String getPreparationType();
}

// OOP: Inheritance (Child Classes)
class Snack extends MenuItem {
    public Snack(String id, String name, BigDecimal price) { super(id, name, price); }
    @Override
    public String getPreparationType() { return "Kitchen Cooked"; }
}

class Beverage extends MenuItem {
    public Beverage(String id, String name, BigDecimal price) { super(id, name, price); }
    @Override
    public String getPreparationType() { return "Barista Prepared"; }
}

// Order Items and Orders
class OrderItem implements Billable {
    private MenuItem item;
    private int quantity;

    public OrderItem(MenuItem item, int quantity) {
        this.item = item;
        this.quantity = quantity;
    }
    public MenuItem getItem() { return item; }
    public int getQuantity() { return quantity; }

    @Override
    public BigDecimal calculateTotal() {
        return item.getPrice().multiply(new BigDecimal(quantity));
    }
}

class Order implements Billable {
    private String token;
    private String studentName;
    private List<OrderItem> items;
    private OrderStatus status;

    public Order(String token, String studentName, List<OrderItem> items) {
        this.token = token;
        this.studentName = studentName;
        this.items = items;
        this.status = OrderStatus.PLACED;
    }

    public String getToken() { return token; }
    public String getStudentName() { return studentName; }
    public OrderStatus getStatus() { return status; }
    public void setStatus(OrderStatus status) { this.status = status; }

    @Override
    public BigDecimal calculateTotal() {
        BigDecimal total = BigDecimal.ZERO;
        for (OrderItem item : items) total = total.add(item.calculateTotal());
        BigDecimal tax = total.multiply(new BigDecimal("0.05"));
        return total.add(tax);
    }
}

// Service (Data Storage)
class CanteenService implements OrderManageable {
    private List<MenuItem> menu = new ArrayList<>();
    private List<Order> orders = new ArrayList<>();
    private int tokenCounter = 1000;

    public CanteenService() {
        // OOP: Polymorphism in action
        menu.add(new Snack("F01", "Veg Sandwich", new BigDecimal("45.00")));
        menu.add(new Snack("F02", "Masala Dosa", new BigDecimal("60.00")));
        menu.add(new Beverage("B01", "Cold Coffee", new BigDecimal("50.00")));
        menu.add(new Beverage("B02", "Hot Tea", new BigDecimal("15.00")));
    }

    public List<MenuItem> getMenu() { return menu; }

    public MenuItem getMenuItemById(String id) {
        for (MenuItem item : menu) {
            if (item.getId().equals(id)) return item;
        }
        return null;
    }

    public Order placeOrder(String studentName, List<OrderItem> cart) {
        String token = "TKN-" + (++tokenCounter);
        Order order = new Order(token, studentName, new ArrayList<>(cart));
        orders.add(order);
        return order;
    }

    public List<Order> getAllOrders() { return orders; }

    @Override
    public void updateOrderStatus(String token, OrderStatus newStatus) {
        for (Order o : orders) {
            if (o.getToken().equals(token)) {
                o.setStatus(newStatus);
                break;
            }
        }
    }
}
